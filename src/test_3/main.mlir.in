func.func @main() -> i32 {
  %uno = arith.constant 1.0 : f32

  %A = memref.alloc() : memref<__SIZE__x__SIZE__xf32>
  %B = memref.alloc() : memref<__SIZE__x__SIZE__xf32>
  %C = memref.alloc() : memref<__SIZE__x__SIZE__xf32>

  linalg.fill ins(%uno : f32) outs(%A : memref<__SIZE__x__SIZE__xf32>)
  linalg.fill ins(%uno : f32) outs(%B : memref<__SIZE__x__SIZE__xf32>)

  func.call @matmul_f32(%A, %B, %C) : (memref<__SIZE__x__SIZE__xf32>, memref<__SIZE__x__SIZE__xf32>, memref<__SIZE__x__SIZE__xf32>) -> ()

  %r0 = arith.constant 0 : index
  %r_half = arith.constant __HALF__ : index
  %r_last = arith.constant __LAST__ : index
  %c_esp = arith.constant __SIZE__.0 : f32

  %d_a = memref.load %C[%r0, %r0] : memref<__SIZE__x__SIZE__xf32>
  %d_b = memref.load %C[%r0, %r_last] : memref<__SIZE__x__SIZE__xf32>
  %d_c = memref.load %C[%r_last, %r_half] : memref<__SIZE__x__SIZE__xf32>

  %ok1 = arith.cmpf oeq, %d_a, %c_esp : f32
  %ok2 = arith.cmpf oeq, %d_b, %c_esp : f32
  %ok3 = arith.cmpf oeq, %d_c, %c_esp : f32
  %ok_a = arith.andi %ok1, %ok2 : i1
  %ok = arith.andi %ok_a, %ok3 : i1

  %uno_i = arith.constant 1 : i32
  %ok_i = arith.extui %ok : i1 to i32
  %fallo = arith.subi %uno_i, %ok_i : i32

  memref.dealloc %C : memref<__SIZE__x__SIZE__xf32>
  memref.dealloc %B : memref<__SIZE__x__SIZE__xf32>
  memref.dealloc %A : memref<__SIZE__x__SIZE__xf32>

  return %fallo : i32
}